# Copy to .env and fill in. NEVER commit .env. All values are for Monad TESTNET (chain id 10143).
# Deployer key. Create a fresh key for this project: `cast wallet new`. Fund it from https://faucet.monad.xyz.
DEPLOYER_PRIVATE_KEY=0x
# Public RPC (QuickNode-hosted, 50 rps). Alternatives: https://rpc.ankr.com/monad_testnet, https://rpc-testnet.monadinfra.com
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
# Optional: Monadscan API key for source verification (Sourcify verification needs no key).
MONADSCAN_API_KEY=
# Canonical testnet contracts (from docs.monad.xyz + erc-8004/erc-8004-contracts README; verified on-chain 2026-09-21)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
USDC_TESTNET=0x534b2f3A21130d7a60830c2Df862319e593943A3
X402_FACILITATOR=https://x402-facilitator.molandak.org
